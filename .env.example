# Entorno
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Vector Studio AI"

# API / Backend (rutas Next.js API)
# Límite de tamaño de subida en MB para la API de trazado
API_MAX_BODY_MB=50

# Modelos de IA (opcional). Si no se configuran o no hay pesos,
# el motor JS puro se usa como respaldo automático.
# Ruta (local o http) a los pesos de Real-ESRGAN (ONNX)
REALESRGAN_MODEL_PATH=
# Ruta a los pesos de Segment Anything (ONNX)
SAM_MODEL_PATH=
# Ruta al modelo de fondo (ONNX)
BGR_MODEL_PATH=
# Runtime: 'onnxruntime-node' | 'pure' (auto-detecta)
AI_RUNTIME=pure

# Ajustes de calidad
DEFAULT_COLOR_COUNT=24
DEFAULT_TURBO=0
DEFAULT_MAX_NODES=0
